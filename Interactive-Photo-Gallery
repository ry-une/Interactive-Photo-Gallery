<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Photo Gallery</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f4;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        #image {
            width: 100%;
            max-width: 400px;
            margin: 20px auto;
        }
        .preview-media {
            aspect-ratio: 4 / 3;
            background-color: #ddd;
            border: 2px solid #333;
        }
        #preview {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        #preview[hidden] { display: none; }
        #caption {
            min-height: 3em;
            margin-top: 12px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }
        #gallery {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
            margin: 20px auto;
        }
        .thumbnail {
            display: block;
            padding: 0;
            border: 2px solid #555;
            border-radius: 4px;
            background: #fff;
            cursor: pointer;
        }
        .thumbnail img {
            display: block;
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 2px;
        }
        .thumbnail:hover,
        .thumbnail[aria-pressed="true"] { border-color: #2046ad; }
        button:focus-visible {
            outline: 3px solid #2046ad;
            outline-offset: 3px;
        }
        #clear-selection {
            min-height: 44px;
            padding: 10px 16px;
            font: inherit;
            color: #333;
            background: #fff;
            border: 1px solid #555;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <main>
        <h1>Interactive Photo Gallery</h1>
        <p id="instructions">Hover or focus to preview. Click, tap, or press Enter or Space to keep a photo selected.</p>
        <figure id="image">
            <div class="preview-media"><img id="preview" alt="" hidden></div>
            <figcaption id="caption" aria-live="polite" aria-atomic="true">Hover, focus, or select a photo below.</figcaption>
        </figure>
        <div id="gallery" role="group" aria-label="Choose a photo" aria-describedby="instructions">
        <button class="thumbnail" type="button" aria-pressed="false">
            <img src="https://images.pexels.com/photos/459493/pexels-photo-459493.jpeg" alt="Coffee Shop with Warm Lights">
        </button>
        <button class="thumbnail" type="button" aria-pressed="false">
            <img src="https://images.pexels.com/photos/414171/pexels-photo-414171.jpeg" alt="Mountain View with Blue Sky">
        </button>
        <button class="thumbnail" type="button" aria-pressed="false">
            <img src="https://images.pexels.com/photos/2904829/pexels-photo-2904829.jpeg" alt="Beach Sunset with Palm Trees">
        </button>
        <button class="thumbnail" type="button" aria-pressed="false">
            <img src="https://images.pexels.com/photos/1462017/pexels-photo-1462017.jpeg" alt="Hiker Walking at Sunset">
        </button>
        <button class="thumbnail" type="button" aria-pressed="false">
            <img src="https://images.pexels.com/photos/3224151/pexels-photo-3224151.jpeg" alt="City Skyline at Night">
        </button>
        <button class="thumbnail" type="button" aria-pressed="false">
            <img src="https://images.pexels.com/photos/374885/pexels-photo-374885.jpeg" alt="Beautiful Flower Garden">
        </button>
        </div>
        <button id="clear-selection" type="button">Clear selection</button>
    </main>
    <script>
        function initGallery() {
            const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
            const preview = document.getElementById('preview');
            const caption = document.getElementById('caption');
            const clear = document.getElementById('clear-selection');
            let hovered = null;
            let focused = null;
            let selected = null;

            function render(button) {
                if (!button) {
                    preview.hidden = true;
                    preview.removeAttribute('src');
                    caption.textContent = 'Hover, focus, or select a photo below.';
                    return;
                }
                const image = button.querySelector('img');
                if (preview.src !== image.src) preview.src = image.src;
                preview.hidden = false;
                // The visible live caption supplies the preview's description.
                caption.textContent = image.alt;
            }

            function restorePreview() {
                render(hovered || focused || selected);
            }

            thumbnails.forEach(button => {
                button.addEventListener('mouseenter', () => {
                    hovered = button;
                    render(button);
                });
                button.addEventListener('mouseleave', () => {
                    if (hovered === button) hovered = null;
                    restorePreview();
                });
                button.addEventListener('focus', () => {
                    focused = button;
                    render(button);
                });
                button.addEventListener('blur', () => {
                    if (focused === button) focused = null;
                    restorePreview();
                });
                // Native buttons provide keyboard activation and touch clicks.
                button.addEventListener('click', () => {
                    selected = button;
                    thumbnails.forEach(item => item.setAttribute('aria-pressed', String(item === selected)));
                    render(button);
                });
            });
            clear.addEventListener('click', () => {
                hovered = focused = selected = null;
                thumbnails.forEach(button => button.setAttribute('aria-pressed', 'false'));
                clear.focus();
                render(null);
            });
        }
        initGallery();
    </script>
</body>
</html>
